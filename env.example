# Korea Investment & Securities open API credentials.
# Copy this file to .env and fill in your values:  cp env.example .env
# Issue an app key/secret at https://apiportal.koreainvestment.com (KIS Developers).
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret

# 계좌번호: 8-digit account number, dash, 2-digit product code.
KIS_ACCOUNT_NO=12345678-01

# true = 모의투자 (paper trading, the default), false = 실전투자 (REAL MONEY).
KIS_PAPER=true

# 모의투자용 자격증명 (선택). KIS 앱키는 **환경별로 발급**되어 서로 호환되지
# 않는다 — 모의 키는 모의 도메인에서만, 실전 키는 실전에서만 동작한다.
# 아래 이름에 모의 값을 두면 KIS_PAPER=true일 때 위의 실전 값 대신 이것들을
# 쓴다(변수별로 독립 판정하므로 일부만 둬도 된다). 없으면 위 공용 이름을
# 그대로 쓰므로 기존 .env는 수정 없이 동작한다.
#
# 이렇게 나눠 두면 양쪽을 .env에 동시에 보관하고 KIS_PAPER 하나로 전환할 수
# 있다. 같은 이름을 두 번 정의해 갈아끼우지 말 것 — python-dotenv는 나중 줄로
# 조용히 덮어써서, 파일 위쪽만 보면 어느 자격증명이 활성인지 알 수 없게 된다.
#KIS_APP_PAPER_KEY=your-paper-app-key
#KIS_APP_PAPER_SECRET=your-paper-app-secret
#KIS_ACCOUNT_PAPER_NO=12345678-01

# Optional: where to cache the 24h access token.
#
# 기본값은 **모드별로 갈린다** — ~/.cache/sontrader/token-paper.json 과
# token-real.json. 파일 하나를 두 모드가 함께 쓰면 캐시가 매번 미스가 나고
# 재발급을 시도하는데, KIS는 발급을 1분당 1회로 제한하고 **재발급 시 이전
# 토큰을 무효화**한다. 실전 수집이 도는 중에 모의 명령을 돌리면 그 수집의
# 토큰이 죽을 수 있다 (docs/system/03-운영.md T31).
#
# 🔴 **이 값을 설정하면 그 모드 분리가 사라진다.** 굳이 지정해야 한다면
# 모드마다 다른 경로를 주고, 아니면 주석 처리해 두는 편이 안전하다.
#SONTRADER_TOKEN_CACHE=/path/to/token.json

# Optional: where to cache the websocket approval_key (실시간-000, 24h).
# 기본값은 토큰과 같은 이유로 모드별로 갈린다 (approval_key-paper.json /
# approval_key-real.json). Used by the live 1-minute-bar collector.
#SONTRADER_APPROVAL_KEY_CACHE=/path/to/approval_key.json

# Optional: PostgreSQL for trading state (`sontrader migrate` creates the tables).
# Only needed for DB commands; point at the same database kis_trading uses.
# EITHER copy the POSTGRES_* lines from kis_trading's .env (recommended —
# credentials are URL-escaped automatically):
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=password
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432
#POSTGRES_DB=postgres
# OR set a full URL (special characters in the password must be %-encoded):
#DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/kis_trading

# Optional: OpenDART API key for `sontrader collect-dart` (공시 수집).
# Issue one at https://opendart.fss.or.kr (무료).
#DART_API_KEY=your-dart-api-key

# Optional: LLM 판단 계층 (6단계) — 실전에서 SONTRADER_ENTRY_TRIGGER=event 일 때만
# 쓴다(기본 watchlist는 LLM을 호출하지 않는다). 백테스트는 저장된 판단만 읽으므로
# API 키가 필요 없다.
#ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: 이벤트 로그 레벨 (기본 INFO). 사이클 상세를 보려면 DEBUG.
# 로그는 stdout으로만 나가고, 앱키·계좌번호·토큰은 자동으로 마스킹된다.
#SONTRADER_LOG_LEVEL=INFO

# Optional: 텔레그램 봇 (6단계) — 체결·손절·장애 알림, 킬 스위치.
# @BotFather로 봇을 만들고 토큰을 발급받은 뒤, 봇과 대화를 시작해 chat_id를 확인한다.
#TELEGRAM_BOT_TOKEN=your-telegram-bot-token
#TELEGRAM_CHAT_ID=your-telegram-chat-id

# 상시 가동의 신규 진입 트리거. watchlist(기본) | event
#   watchlist — 모멘텀 워치리스트 순위대로 진입. LLM 불필요.
#   event     — 공시 + LLM 판단. ANTHROPIC_API_KEY가 있어야 하고,
#               없으면 기동 시 실패한다(조용히 진입 0건이 되는 것을 막는다).
# 자동 전환하지 않는 이유: 키를 지우는 것만으로 전략이 바뀌면 안 된다.
SONTRADER_ENTRY_TRIGGER=watchlist
